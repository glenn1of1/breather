# Every environment variable Breather reads. Copy to .env.local and fill in. Never commit real values.
# Nothing here is NEXT_PUBLIC_ except the app URL, which is not a secret.

# --- Database (Supabase Postgres, transaction pooler, port 6543) ---
# Writer: postgres role. Used by the survey API, recompute(), seed and migrations. Never imported by dashboard code.
DATABASE_URL=
# Read-only dashboard role: SELECT on the employer schema only, no access to intake (PRD PRV-1).
DASHBOARD_DATABASE_URL=
# Local only: npm run db:migrate sets this as the dashboard role's password.
DASHBOARD_DB_PASSWORD=
# Local only: kept alongside the URLs for reference; the app does not read it.
SUPABASE_DB_PASSWORD=

# --- Jev (TypeSafe AI) ---
TYPESAFE_API_KEY=
# live | mock (default mock: no network calls)
JEV_MODE=
# Most live Jev calls allowed per UTC day per server instance (default 500; 0 turns Jev off). SEC-2.
JEV_DAILY_CALL_CAP=

# --- Demo access gate (SEC-1) ---
# Comma-separated codes, one per recipient. Remove a code to revoke it (its cookies stop working at once).
DEMO_ACCESS_CODES=
# At least 32 random characters, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
DEMO_COOKIE_SECRET=

# --- SE Health logo (kept out of the repo) ---
# The demo's SE Health logo as a base64 PNG: `base64 -i private/se-health-logo.png | pbcopy`.
# Unset, the demo shows a plain "SE Health" wordmark instead.
SE_HEALTH_LOGO_PNG_BASE64=

# --- URLs ---
# Base URL for metadata when not on Vercel (Vercel uses its production domain automatically).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Scripts and tests only ---
# npm run checkpoint: a code from the target deployment's DEMO_ACCESS_CODES.
CHECKPOINT_ACCESS_CODE=
# Playwright: the code to sign in with (defaults to the first DEMO_ACCESS_CODES entry).
E2E_ACCESS_CODE=
# Playwright: test a running deployment instead of starting a local server.
E2E_BASE_URL=

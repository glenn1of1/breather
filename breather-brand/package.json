{
  "name": "@breather/brand",
  "version": "1.0.0",
  "description": "Breather brand kit: SE Health tokens, CSS, Tailwind v4 theme, React components, brand shapes, employer co-brand themes and the full brand guidelines (Markdown).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./react": { "types": "./src/react.d.ts", "default": "./src/react.js" },
    "./tokens.json": "./tokens/tokens.json",
    "./css/*": "./css/*",
    "./themes/*": "./themes/*",
    "./assets/*": "./assets/*",
    "./docs/*": "./docs/*",
    "./package.json": "./package.json"
  },
  "files": ["src", "css", "tokens", "themes", "assets", "docs", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/brand.test.mjs",
    "prepack": "node scripts/build.mjs && node --test test/brand.test.mjs"
  },
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "keywords": ["breather", "se-health", "design-tokens", "brand", "tailwind", "shadcn"]
}

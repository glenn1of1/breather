  "themes": [
    {
      "theme": "Time and focus back for work",
      "participantCount": 7,
      "quotes": [
        {
          "quoteHash": "fc07b8872a82f8cd",
          "text": "For the first time in months I made it through a full week of meetings without leaving early."
        },
        {
          "quoteHash": "77f047dac7f14da2",
          "text": "Having someone with my dad on Tuesdays means I can actually focus at work that day."
        }
      ]
    },
    {
      "theme": "Booking and scheduling is confusing",
      "participantCount": 5,
      "quotes": [
        {
          "quoteHash": "6e847e5b566e83df",
          "text": "Booking the first visit took three phone calls, I almost gave up."
        },
        {
          "quoteHash": "d39b4bfae689db0b",
          "text": "The scheduling portal was confusing, I wasn't sure if my booking went through."
        }
      ]
    },
    {
      "theme": "Easier and less guilty to ask for help",
      "participantCount": 5,
      "quotes": [
        {
          "quoteHash": "1975af293dcad74d",
          "text": "I didn't have to explain myself to anyone, I just signed up. That made it easier to ask."
        },
        {
          "quoteHash": "91a7675e79bcb289",
          "text": "Knowing it was anonymous made it easier to sign up. I didn't want HR to know my situation."
        }
      ]
    },
    {
      "theme": "Trust in the carers",
      "participantCount": 5,
      "quotes": [
        {
          "quoteHash": "cf9b27b1cb7880ec",
          "text": "The carer was great with my dad, he actually looks forward to it now."
        },
        {
          "quoteHash": "00b8ceb717ea4ae4",
          "text": "I trust the carers now, at first I was nervous leaving my mom with a stranger."
        }
      ]
    },
    {
      "theme": "Worry about when the funding ends",
      "participantCount": 5,
      "quotes": [
        {
          "quoteHash": "f172cc01d87991e2",
          "text": "What happens in March when the funding stops? I don't want to get used to this and lose it."
        },
        {
          "quoteHash": "bd495ca045bbf3ba",
          "text": "I'd pay part of it myself if the company didn't, it's been that useful. But I worry it ends."
        }
      ]
    }
